<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>IndicoPenSpike</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IndicoPenSpike.Core\IndicoPenSpike.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyWinUIResourceArtifactsToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIResourceArtifacts Include="$(TargetDir)App.xbf" Condition="Exists('$(TargetDir)App.xbf')" />
      <_WinUIResourceArtifacts Include="$(TargetDir)MainWindow.xbf" Condition="Exists('$(TargetDir)MainWindow.xbf')" />
      <_WinUIResourceArtifacts Include="$(TargetDir)IndicoPenSpike.pri" Condition="Exists('$(TargetDir)IndicoPenSpike.pri')" />
    </ItemGroup>

    <Copy
      SourceFiles="@(_WinUIResourceArtifacts)"
      DestinationFolder="$(PublishDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
